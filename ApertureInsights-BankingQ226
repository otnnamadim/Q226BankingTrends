const COLORS = {"JPM": "#ccc2f6", "BAC": "#e8998a", "C": "#6fc3d6", "WFC": "#e5c06b", "GS": "#86d1a0", "MS": "#d99bce", "BK": "#aeb6c4"};
let freq = "annual";
let active = new Set(Object.keys(COLORS));
const charts = new Map();
const TICK = "#8a929b", GRID = "rgba(204,194,246,0.09)", TT_BG = "#01032d", WARM = "#d85a30";

function buildDatasets(metric) {
  const byBank = (DATA[freq] || {})[metric] || {};
  return Object.entries(byBank)
    .filter(([t]) => active.has(t))
    .map(([t, pts]) => ({
      label: t,
      data: pts,
      borderColor: COLORS[t],
      backgroundColor: COLORS[t],
      borderWidth: 1.6,
      pointRadius: pts.map(p => p.prelim ? 6 : 0),
      pointStyle: pts.map(p => p.prelim ? "star" : "circle"),
      pointBorderColor: pts.map(p => p.prelim ? WARM : COLORS[t]),
      pointBackgroundColor: pts.map(p => p.prelim ? WARM : COLORS[t]),
      segment: {
        borderDash: ctx => (ctx.p1.raw && ctx.p1.raw.prelim) ? [5, 4] : undefined,
      },
      spanGaps: true,
      tension: 0.1,
    }));
}

function makeChart(canvas) {
  const metric = canvas.dataset.metric;
  const chart = new Chart(canvas, {
    type: "line",
    data: { datasets: buildDatasets(metric) },
    options: {
      responsive: true, maintainAspectRatio: false, animation: false,
      parsing: { xAxisKey: "x", yAxisKey: "y" },
      interaction: { mode: "nearest", intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: TT_BG, borderColor: "#232c48", borderWidth: 1,
          titleColor: "#d9d9d9", bodyColor: "#c6cbd1",
          titleFont: { family: "Helvetica Neue" }, bodyFont: { family: "Helvetica Neue" },
          callbacks: {
            label: c => `${c.dataset.label}: ${c.parsed.y.toLocaleString()}` +
                       (c.raw.prelim ? " (preliminary, 8-K)" : ""),
          },
        },
      },
      scales: {
        x: { type: "time", time: { unit: "year" }, grid: { display: false },
             border: { color: "#232c48" },
             ticks: { color: TICK, font: { family: "Helvetica Neue", size: 11 } } },
        y: { grid: { color: GRID }, border: { color: "#232c48" },
             ticks: { color: TICK, font: { family: "Helvetica Neue", size: 11 } } },
      },
    },
  });
  charts.set(metric, chart);
}

function refresh() {
  charts.forEach((chart, metric) => {
    chart.data.datasets = buildDatasets(metric);
    chart.update("none");
  });
}

document.querySelectorAll(".freq-btn").forEach(btn => btn.addEventListener("click", () => {
  freq = btn.dataset.freq;
  document.querySelectorAll(".freq-btn").forEach(b =>
    b.setAttribute("aria-pressed", String(b === btn)));
  refresh();
}));

document.querySelectorAll(".bank-chip").forEach(chip => chip.addEventListener("click", () => {
  const t = chip.dataset.ticker;
  if (active.has(t) && active.size > 1) active.delete(t); else active.add(t);
  chip.setAttribute("aria-pressed", String(active.has(t)));
  refresh();
}));
</script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"
        onload="document.querySelectorAll('canvas[data-metric]').forEach(makeChart)"></script>
