def render_sections(sections: "list[tuple[str, list[str]]]") -> str:
    html = []
    for group, metrics in sections:
        blocks = []
        for metric in metrics:
            unit = "$ / share" if metric in PER_SHARE_METRICS else "USD billions"
            blocks.append(f'''
      <figure class="chart-block">
        <figcaption>
          <h3>{metric}</h3>
          <span class="unit">{unit}</span>
        </figcaption>
        <div class="canvas-wrap"><canvas data-metric="{metric}"></canvas></div>
      </figure>''')
        grid = "chart-grid cols-2" if len(metrics) > 1 else "chart-grid"
        html.append(f'''
    <section>
      <h2>{group}</h2>
      <p class="narrative">{SECTION_NARRATIVE.get(group, "")}</p>
      <div class="{grid}">{"".join(blocks)}</div>
    </section>''')
    return "".join(html)


def render_html(data, sections, thead, tbody, prelim_banks, manual_note,
                omissions_html) -> str:
