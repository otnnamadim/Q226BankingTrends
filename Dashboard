# Entry point
# ---------------------------------------------------------------------------

def main() -> None:
    ap = argparse.ArgumentParser(description="Build index.html from bank_panel.csv")
    ap.add_argument("--panel", default="bank_panel.csv", help="input panel CSV")
    ap.add_argument("--out", default="index.html", help="output HTML file")
    args = ap.parse_args()

    panel = load_panel(args.panel)
    sections = charted_metrics(panel)
    metrics = [m for _, ms in sections for m in ms]

    data = build_data(panel, metrics)
    thead, tbody, prelim_banks, omissions = build_snapshot(data, metrics)
    note = manual_filed_note(panel)
    omissions_html = render_omissions(omissions)

    html = render_html(data, sections, thead, tbody, prelim_banks, note,
                       omissions_html)
    with open(args.out, "w", encoding="utf-8") as fh:
        fh.write(html)

    n_pts = sum(len(pts) for f in data.values() for m in f.values() for pts in m.values())
    n_prelim = sum(1 for f in data.values() for m in f.values()
                   for pts in m.values() for p in pts if p["prelim"])
    latest = max((p["x"] for p in data["quarterly"].get("Total Revenue", {}).get("JPM", [])),
                 default="n/a")

    print(f"Wrote {args.out}")
    print(f"  sections : {', '.join(g for g, _ in sections)}")
    print(f"  metrics  : {len(metrics)}  ({', '.join(metrics)})")
    print(f"  points   : {n_pts} ({n_prelim} preliminary)")
    print(f"  snapshot : quarterly, latest JPM revenue point {latest}")
    print(f"  site url : {SITE_URL}")
    if prelim_banks:
        print(f"  starred  : {', '.join(sorted(prelim_banks))}")
    for ticker, metric, kind, _ in omissions:
        print(f"  blank    : {ticker} {metric}  [{kind}]")


if __name__ == "__main__":
    main()
