# footnote below the table.
OMISSION_NOTES = {
    ("BK", "Investment Banking Fees"): (
        "structural",
        "BNY Mellon is a custody and asset-servicing bank with no investment "
        "banking segment."),
    ("WFC", "Investment Banking Fees"): (
