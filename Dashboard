    "tagging",
    "No us-gaap concept matched for this filer — likely a custom extension tag "
    "or narrative-only disclosure.")

# Filed data outranks a hand-entered filed figure, which outranks preliminary.
FORM_PRIORITY = {
    "10-Q/A": 5, "10-K": 4, "10-Q": 4, "8-K": 3,
    MANUAL_FILED_LABEL: 2, PRELIM_FORM_LABEL: 1,
}


# ---------------------------------------------------------------------------
# Data assembly
# ---------------------------------------------------------------------------

def load_panel(path: str) -> pd.DataFrame:
    if not os.path.exists(path):
        raise SystemExit(
            f"Panel not found at '{os.path.abspath(path)}'.\n"
            f"Run  python edgar_bank_pipeline.py  first to produce it."
        )
    panel = pd.read_csv(path)
    panel["end"] = pd.to_datetime(panel["end"], errors="coerce")
    panel["val"] = pd.to_numeric(panel["val"], errors="coerce")
    panel = panel[panel["end"].notna() & panel["val"].notna()].copy()
    if panel.empty:
        raise SystemExit(f"'{path}' contains no usable rows.")
    return panel


def charted_metrics(panel: pd.DataFrame) -> "list[tuple[str, list[str]]]":
    """Group -> metrics, keeping only metrics that actually have data."""
    present = set(panel["metric"].unique())
    out = []
    for group, metrics in METRIC_GROUPS.items():
        keep = [m for m in metrics if m in present]
        if keep:
            out.append((group, keep))
    return out


def build_data(panel: pd.DataFrame, metrics: "list[str]") -> dict:
    """Nested dict: frequency -> metric -> ticker -> [{x, y, prelim}]."""
    work = panel[panel["metric"].isin(metrics)].copy()
    work["prio"] = work["form"].map(FORM_PRIORITY).fillna(0)
    work["accn"] = work["accn"].fillna("")
    # One observation per (frequency, metric, ticker, end): filed beats manual
    # beats preliminary; ties broken by accession so restatements win.
    work = work.sort_values(["prio", "accn"]).groupby(
        ["frequency", "metric", "ticker", "end"], as_index=False).tail(1)

    data = {}
    for freq in ("annual", "quarterly"):
        data[freq] = {}
        for metric in metrics:
            by_bank = {}
            for ticker in COLORS:
                series = work[(work["frequency"] == freq)
                              & (work["metric"] == metric)
                              & (work["ticker"] == ticker)].sort_values("end")
                if series.empty:
                    continue
                per_share = metric in PER_SHARE_METRICS
                divisor = 1.0 if per_share else 1e9
                places = 2 if per_share else 3
                by_bank[ticker] = [
                    {"x": r.end.strftime("%Y-%m-%d"),
                     "y": round(r.val / divisor, places),
                     "prelim": bool(r.form == PRELIM_FORM_LABEL)}
                    for r in series.itertuples()
                ]
            if by_bank:
                data[freq][metric] = by_bank
    return data


def build_snapshot(data: dict, metrics: "list[str]") -> "tuple[str, str, set, list]":
    """Cross-bank table at QUARTERLY frequency — the newest quarter per bank."""
    quarterly = data.get("quarterly", {})
    head = ('<tr><th style="text-align:left">Bank</th>'
            + "".join(f"<th>{m}</th>" for m in metrics) + "</tr>")

    rows, prelim_banks, omissions = [], set(), []
    for ticker, colour in COLORS.items():
        cells = [f'<td class="tick" style="--c:{colour}">{ticker}</td>']
        for metric in metrics:
            points = quarterly.get(metric, {}).get(ticker)
            if not points:
                kind, reason = OMISSION_NOTES.get((ticker, metric), DEFAULT_OMISSION)
                omissions.append((ticker, metric, kind, reason))
                cells.append(f'<td class="na" title="{ticker} — {metric}: {reason}">—</td>')
                continue
            latest = points[-1]
            star = "★" if latest["prelim"] else ""
            if latest["prelim"]:
                prelim_banks.add(ticker)
            cells.append(f'<td>{latest["y"]:.2f}{star}</td>')
        rows.append("<tr>" + "".join(cells) + "</tr>")
    return head, "".join(rows), prelim_banks, omissions


def render_omissions(omissions: "list[tuple[str, str, str, str]]") -> str:
    """Footnote explaining every blank cell, grouped so a structural absence is
    never mistaken for missing data (or vice versa)."""
    if not omissions:
        return ""
    structural = [o for o in omissions if o[2] == "structural"]
    tagging = [o for o in omissions if o[2] == "tagging"]

    parts = ['<p class="table-note">Blank cells (—) are not errors, and they carry '
             'two different meanings:</p><ul class="table-note">']
    if structural:
        for ticker, metric, _, reason in structural:
            parts.append(f'<li><strong>{ticker} · {metric}</strong> — not applicable. '
                         f'{reason}</li>')
    if tagging:
        for ticker, metric, _, reason in tagging:
            parts.append(f'<li><strong>{ticker} · {metric}</strong> — reported by the '
                         f'bank but not retrievable. {reason}</li>')
    parts.append('</ul>')
    return "".join(parts)


def manual_filed_note(panel: pd.DataFrame) -> str:
    """Disclose hand-entered FILED figures — they render unstarred, so the
    page must say so explicitly rather than implying full automation."""
    manual = panel[panel["form"] == MANUAL_FILED_LABEL]
    if manual.empty:
        return ""
    parts = []
    for ticker, grp in manual.groupby("ticker"):
        periods = sorted({f"{r.fp} {int(r.fy)}" for r in grp.itertuples()})
        source = str(grp["xbrl_tag"].iloc[0]).replace("manual: ", "")
        parts.append(f"{ticker} {', '.join(periods)} ({source})")
    return (" Hand-entered from filed 10-Qs that SEC has not yet ingested into "
            "Company Facts: " + "; ".join(parts) +
            ". These are filed values, not preliminary, and are shown unstarred.")


