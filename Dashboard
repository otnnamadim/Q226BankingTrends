    chips = "".join(
        f'<button class="bank-chip" data-ticker="{t}" style="--c:{c}" '
        f'aria-pressed="true">{t}</button>' for t, c in COLORS.items())

    if prelim_banks:
        banner = (f'<p class="prelim-banner">★ Preliminary, unaudited figures from '
                  f'Q2 2026 earnings-release 8-Ks ({", ".join(sorted(prelim_banks))}). '
                  f'Replaced automatically when the corresponding 10-Qs are filed and '
                  f'processed.{manual_note}</p>')
    else:
        banner = f'<p class="prelim-banner">All charted figures are from filed reports.{manual_note}</p>' \
            if manual_note else ""

    generated = date.today().strftime("%B %-d, %Y") if os.name != "nt" else date.today().strftime("%B %d, %Y")

    return f'''<!DOCTYPE html>
